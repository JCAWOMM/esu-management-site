# Copy to .env (or set these in your host's dashboard)
NODE_ENV=production
SITE_URL=https://esumllc.com
DATA_DIR=/var/data            # persistent disk path where the database and photos are stored

# First ESU admin login (created on first start only)
ADMIN_EMAIL=you@esumllc.com
ADMIN_PASSWORD=choose-a-long-password

# Shown on the public site (leave blank to hide)
BUSINESS_PHONE=(718) 555-0000
BUSINESS_EMAIL=service@esumllc.com
BUSINESS_ADDRESS=Brooklyn, NY
BUSINESS_HOURS=Mon–Fri 8 AM–6 PM · Emergency line 24/7

# Email notifications (any SMTP provider: Google Workspace, Microsoft 365, SendGrid, Postmark…)
OFFICE_EMAIL=dispatch@esumllc.com     # receives every new request and quote
MAIL_FROM=ESU Management <no-reply@esumllc.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
